#pragma once

#include <ATen/ops/empty.h>
#include <c10/util/Exception.h>

#include <ATen/Dispatch.h>
#include <ATen/OpMathType.h>
#include <ATen/native/ForeachUtils.h>
#if !defined(__MUSA_ARCH__) || __MUSA_ARCH__ <= 320
#include <musa_robust.h>
#endif
#include <ATen/native/musa/MemoryAccess.muh>

#include <cstdint>

#include "torch_musa/csrc/aten/musa/MUSAContext.h"
#include "torch_musa/csrc/aten/musa/MUSAGraphsUtils.muh"
#include "torch_musa/csrc/aten/musa/MUSAMath.muh"
#include "torch_musa/csrc/core/MUSAStream.h"

namespace at::musa {
// multi_tensor_apply helper
namespace {
static constexpr int64_t kILP = 8;
static constexpr int64_t kChunkSize = 2048;
static constexpr int64_t kBlockSize = 256;

static constexpr int depth_to_max_tensors[5] = {110, 64, 48, 100, 80};
static constexpr int depth_to_max_blocks[5] =
    {819200, 819200, 819200, 819200, 1048576};
static constexpr int depth_to_max_tensors_scalarlist[5] = {96, 64, 48, 100, 80};

// Smaller kernel-argument metadata layout for architectures older than mp_31.
// These values are compile-time capacities, not runtime limits, so the
// generated kernel argument itself is smaller on the legacy path.
static constexpr int depth_to_max_tensors_arch_lt_310[5] =
    {110, 64, 48, 36, 30};
static constexpr int depth_to_max_blocks_arch_lt_310[5] =
    {320, 320, 320, 320, 320};
static constexpr int depth_to_max_tensors_scalarlist_arch_lt_310[5] =
    {96, 64, 48, 36, 31};

// For easy of checking the affect of `__launch_bounds__`
template <
    int block_size = kBlockSize,
    int chunk_size = kChunkSize,
    typename T,
    typename U,
    typename... ArgTypes>
C10_LAUNCH_BOUNDS_1(block_size)
__global__ void multi_tensor_apply_kernel(
    T tensorListMeta,
    U callable,
    ArgTypes... args) {
  // Hand the chunk information to the user-supplied functor to process however
  // it likes.
  callable(chunk_size, tensorListMeta, args...);
}

template <int ilp = kILP, typename T>
__device__ __forceinline__ void load_store(
    T* dst,
    T* src,
    int64_t dst_offset,
    int64_t src_offset) {
  using LT = at::native::memory::aligned_vector<T, ilp>;
  ((LT*)dst)[dst_offset] = ((LT*)src)[src_offset];
}

template <int depth, int ilp = kILP, typename T>
__device__ __forceinline__ void load_args(
    T r_args[][ilp],
    T** args,
    const int64_t i_start,
    const int64_t chunk_size,
    const int64_t n) {
  for (int ii = 0; ii < ilp; ii++) {
    const auto i = i_start + threadIdx.x + ii * blockDim.x;
    for (int r_index = 0; r_index < depth; r_index++) {
      r_args[r_index][ii] = 0;
      if (i < n && i < chunk_size) {
        r_args[r_index][ii] = args[r_index][i];
      }
    }
  }
}

template <int ilp = kILP, typename T>
__device__ __forceinline__ void store_args(
    T* dst,
    T* src,
    const int64_t i_start,
    const int64_t chunk_size,
    const int64_t n) {
  for (int ii = 0; ii < ilp; ii++) {
    const int64_t i = i_start + threadIdx.x + ii * blockDim.x;
    if (i < n && i < chunk_size)
      dst[i] = src[ii];
  }
}

} // namespace

namespace {

enum class ADAM_MODE : uint8_t { ORIGINAL = 0, ADAMW = 1 };

constexpr uint8_t kParamIdx = 0;
constexpr uint8_t kGradIdx = 1;
constexpr uint8_t kExpAvgIdx = 2;
constexpr uint8_t kExpAvgSqIdx = 3;
constexpr uint8_t kMaxExpAvgSqIdx = 4;

template <ADAM_MODE mode, typename opmath_t>
__device__ __forceinline__ opmath_t apply_grad_decay(
    const opmath_t grad,
    const opmath_t param,
    const opmath_t weight_decay) {
  if constexpr (mode == ADAM_MODE::ORIGINAL) {
    return grad + param * weight_decay;
  }
  return grad;
}

template <ADAM_MODE mode, typename opmath_t>
__device__ __forceinline__ opmath_t
apply_param_decay(const opmath_t param, const opmath_t decay) {
  if constexpr (mode == ADAM_MODE::ADAMW) {
    return decay * param;
  }
  return param;
}

// The robust v4 address intrinsics are available only on mp_31/mp_32.  Keep
// the bounds-safe implementation on those targets, while compiling the same
// vectorized kernel for newer architectures with ordinary vector accesses.
// The caller limits vector loads/stores to the full-vector prefix, so the
// scalar tail never relies on an out-of-bounds robust access.
template <typename T>
class FusedAdamVectorAccess {
 public:
#if !defined(__MUSA_ARCH__) || __MUSA_ARCH__ <= 320
  __device__ __forceinline__ FusedAdamVectorAccess(T* ptr, uint64_t size_bytes)
      : descriptor_(ptr, size_bytes) {}
#else
  __device__ __forceinline__ FusedAdamVectorAccess(T* ptr, uint64_t size_bytes)
      : ptr_(ptr) {}
#endif

  template <typename Vec>
  __device__ __forceinline__ Vec load(int index) const {
#if !defined(__MUSA_ARCH__) || __MUSA_ARCH__ <= 320
    return __musa::robust_load<Vec>(descriptor_, index);
#else
    Vec value;
    __builtin_memcpy(&value, ptr_ + index, sizeof(Vec));
    return value;
#endif
  }

  template <typename Vec>
  __device__ __forceinline__ void store(const Vec& value, int index) const {
#if !defined(__MUSA_ARCH__) || __MUSA_ARCH__ <= 320
    __musa::robust_store(value, descriptor_, index);
#else
    __builtin_memcpy(ptr_ + index, &value, sizeof(Vec));
#endif
  }

 private:
#if !defined(__MUSA_ARCH__) || __MUSA_ARCH__ <= 320
  __musa::robust_ptr<T> descriptor_;
#else
  T* ptr_;
#endif
};

template <typename opmath_t, int depth, typename T, typename TensorListMetadata>
__device__ void init_args(
    T** args,
    TensorListMetadata& tl,
    const int64_t chunk_idx,
    const int64_t chunk_size,
    const int64_t tensor_loc) {
  for (int i = 0; i < depth; i++) {
    args[i] = (T*)tl.addresses[i][tensor_loc];
    args[i] += chunk_idx * chunk_size;
  }
}

template <typename scalar_type, int depth>
struct FusedAdamILP {
  // The fp32 non-AMSGrad fast path uses a private ILP16 vector body below.
  // Keep the generic ILP at 8 so dispatch variants with scalar tails do not
  // inherit a larger local frame and lose occupancy.
  static constexpr bool half_or_bfloat =
      std::is_same<scalar_type, c10::Half>::value ||
      std::is_same<scalar_type, c10::BFloat16>::value;
  static constexpr int value = (depth == 5 || half_or_bfloat) ? 4 : kILP;
};

template <typename scalar_type, int depth>
struct FusedAdamChunkSize {
  static constexpr bool fp32_adam =
      std::is_same<scalar_type, float>::value && depth == 4;
  static constexpr bool half_or_bfloat =
      std::is_same<scalar_type, c10::Half>::value ||
      std::is_same<scalar_type, c10::BFloat16>::value;
  static constexpr int value =
      (depth == 5 || half_or_bfloat) ? 1024 : (fp32_adam ? 1024 : kChunkSize);
};

template <typename scalar_type, int depth>
struct FusedAdamBlockSize {
  static constexpr bool fp32_adam =
      std::is_same<scalar_type, float>::value && depth == 4;
  static constexpr bool half_or_bfloat =
      std::is_same<scalar_type, c10::Half>::value ||
      std::is_same<scalar_type, c10::BFloat16>::value;
  // One vector (ILP16) per thread is the fp32 non-AMSGrad tuning point;
  // half/bfloat paths use fewer registers with their smaller block sizes.
  static constexpr int value =
      fp32_adam ? 64 : (half_or_bfloat ? (depth == 5 ? 64 : 128) : kBlockSize);
};

template <typename scalar_type, int depth>
struct FusedAdamMaxBlocks {
  static constexpr bool half_or_bfloat =
      std::is_same<scalar_type, c10::Half>::value ||
      std::is_same<scalar_type, c10::BFloat16>::value;
  static constexpr bool fp32_adam =
      std::is_same<scalar_type, float>::value && depth == 4;
  static constexpr int value = half_or_bfloat
      ? 102400
      : (fp32_adam ? 546134 : depth_to_max_blocks[depth - 1]);
};

// Keep architecture-dependent metadata sizing behind one template dimension.
// This deliberately avoids exposing max_tensors/max_blocks as independent
// template parameters, which would create a combinatorial set of kernels.
enum class FusedAdamMetadataConfig : uint8_t {
  Default = 0,
  ArchLt310 = 1,
};

template <FusedAdamMetadataConfig config, typename scalar_type, int depth>
struct FusedAdamMetadataTraits;

template <typename scalar_type, int depth>
struct FusedAdamMetadataTraits<
    FusedAdamMetadataConfig::Default,
    scalar_type,
    depth> {
  static_assert(depth >= 1 && depth <= 5, "unsupported tensor-list depth");
  static constexpr int max_tensors = depth_to_max_tensors[depth - 1];
  static constexpr int max_blocks =
      FusedAdamMaxBlocks<scalar_type, depth>::value;
  static constexpr int max_tensors_scalarlist =
      depth_to_max_tensors_scalarlist[depth - 1];
};

template <typename scalar_type, int depth>
struct FusedAdamMetadataTraits<
    FusedAdamMetadataConfig::ArchLt310,
    scalar_type,
    depth> {
  static_assert(depth >= 1 && depth <= 5, "unsupported tensor-list depth");
  static constexpr int max_tensors =
      depth_to_max_tensors_arch_lt_310[depth - 1];
  static constexpr int max_blocks = depth_to_max_blocks_arch_lt_310[depth - 1];
  static constexpr int max_tensors_scalarlist =
      depth_to_max_tensors_scalarlist_arch_lt_310[depth - 1];
};

template <
    int n,
    typename scalar_type,
    typename opmath_t,
    FusedAdamMetadataConfig config>
struct FusedAdamOptimizerTensorListMetadata {
  using Traits = FusedAdamMetadataTraits<config, scalar_type, n>;

  static constexpr int max_tensors = Traits::max_tensors;
  static constexpr int max_blocks = Traits::max_blocks;
  static constexpr int max_tensors_scalarlist = Traits::max_tensors_scalarlist;

  const void* addresses[n][max_tensors];
  int64_t numel_for_tensor[max_tensors];
  bool all_aligned[max_tensors];

  // Tensor LR stores bias correction here; scalar LR stores the precomputed
  // step size. FusedAdamMathFunctor::run() normalizes both to step_size.
  opmath_t bias_correction1_r_or_step_size[max_tensors_scalarlist];
  opmath_t bias_correction2_rsqrt[max_tensors_scalarlist];

  // Chunk indices are element offsets divided by chunk_size. Keep the base
  // in 64 bits so a tensor with more than INT32_MAX elements cannot wrap when
  // its chunk pointer is reconstructed in the device kernel.
  int64_t block_to_chunk_base[max_tensors];

  unsigned char block_to_tensor[max_blocks];
  unsigned short block_to_chunk[max_blocks];
};

template <
    typename scalar_type,
    typename opmath_t,
    int depth,
    int ilp,
    ADAM_MODE adam_mode,
    bool amsgrad,
    bool has_grad_scale,
    bool maximize,
    bool has_weight_decay>
__device__ __forceinline__ void AdamMath(
    scalar_type r_args[depth][ilp],
    const double& lr,
    const double& beta1,
    const double& beta2,
    const opmath_t& step_size,
    const opmath_t& bias_correction2_rsqrt,
    const double& weight_decay,
    const double& eps,
    const float* grad_scale_ptr) {
  const opmath_t lr_t = static_cast<opmath_t>(lr);
  const opmath_t beta1_t = static_cast<opmath_t>(beta1);
  const opmath_t beta2_t = static_cast<opmath_t>(beta2);
  const opmath_t eps_t = static_cast<opmath_t>(eps);

  for (int ii = 0; ii < ilp; ii++) {
    opmath_t param = static_cast<opmath_t>(r_args[kParamIdx][ii]);
    opmath_t grad = static_cast<opmath_t>(r_args[kGradIdx][ii]);
    opmath_t grad_to_store;
    if constexpr (has_grad_scale) {
      grad /= static_cast<opmath_t>(*grad_scale_ptr);
      grad_to_store = grad;
    }
    if constexpr (maximize) {
      grad = -grad;
    }
    opmath_t exp_avg = static_cast<opmath_t>(r_args[kExpAvgIdx][ii]);
    opmath_t exp_avg_sq = static_cast<opmath_t>(r_args[kExpAvgSqIdx][ii]);
    opmath_t max_exp_avg_sq;
    if constexpr (amsgrad) {
      max_exp_avg_sq = static_cast<opmath_t>(r_args[kMaxExpAvgSqIdx][ii]);
    }

    if constexpr (has_weight_decay) {
      const opmath_t weight_decay_t = static_cast<opmath_t>(weight_decay);
      if constexpr (adam_mode == ADAM_MODE::ORIGINAL) {
        grad += param * weight_decay_t;
      } else if constexpr (adam_mode == ADAM_MODE::ADAMW) {
        param -= lr_t * weight_decay_t * param;
      }
    }

    const opmath_t grad_2 = grad * grad;
    opmath_t denom;
    if constexpr (std::is_same<opmath_t, float>::value) {
      exp_avg = fmaf(beta1_t, exp_avg, fmaf(-beta1_t, grad, grad));
      exp_avg_sq = fmaf(beta2_t, exp_avg_sq, fmaf(-beta2_t, grad_2, grad_2));
      if constexpr (amsgrad) {
        max_exp_avg_sq = fmaxf(max_exp_avg_sq, exp_avg_sq);
        denom = fmaf(sqrtf(max_exp_avg_sq), bias_correction2_rsqrt, eps_t);
      } else {
        denom = fmaf(sqrtf(exp_avg_sq), bias_correction2_rsqrt, eps_t);
      }
    } else {
      exp_avg = fma(beta1_t, exp_avg, fma(-beta1_t, grad, grad));
      exp_avg_sq = fma(beta2_t, exp_avg_sq, fma(-beta2_t, grad_2, grad_2));
      if constexpr (amsgrad) {
        max_exp_avg_sq = fmax(max_exp_avg_sq, exp_avg_sq);
        denom = (sqrt(max_exp_avg_sq) * bias_correction2_rsqrt) + eps_t;
      } else {
        denom = fma(sqrt(exp_avg_sq), bias_correction2_rsqrt, eps_t);
      }
    }

    param -= step_size * exp_avg / denom;

    r_args[kParamIdx][ii] = param;
    if constexpr (has_grad_scale) {
      r_args[kGradIdx][ii] = grad_to_store;
    }
    r_args[kExpAvgIdx][ii] = exp_avg;
    r_args[kExpAvgSqIdx][ii] = exp_avg_sq;
    if constexpr (amsgrad) {
      r_args[kMaxExpAvgSqIdx][ii] = max_exp_avg_sq;
    }
  }
}

template <
    typename scalar_type,
    int depth,
    ADAM_MODE adam_mode,
    bool amsgrad,
    bool has_grad_scale,
    bool maximize,
    bool has_weight_decay>
struct FusedAdamMathFunctor {
  static_assert(
      depth == 4 || depth == 5,
      "depth of 4 for Adam, depth of 5 for Adam with AMSGrad.");
  using opmath_t = at::opmath_type<scalar_type>;

  __device__ __forceinline__ void run_scalar_tail(
      scalar_type* args[depth],
      const int64_t start,
      const int64_t n,
      const int64_t chunk_size,
      const double& lr,
      const double& beta1,
      const double& beta2,
      const opmath_t& step_size,
      const opmath_t& bias_correction2_rsqrt,
      const double& weight_decay,
      const double& eps,
      const float* grad_scale_ptr) {
    for (int64_t i = start + threadIdx.x; i < n && i < chunk_size;
         i += blockDim.x) {
      scalar_type tail_args[depth][1];
      for (int j = 0; j < depth; ++j) {
        tail_args[j][0] = args[j][i];
      }
      AdamMath<
          scalar_type,
          opmath_t,
          depth,
          1,
          adam_mode,
          amsgrad,
          has_grad_scale,
          maximize,
          has_weight_decay>(
          tail_args,
          lr,
          beta1,
          beta2,
          step_size,
          bias_correction2_rsqrt,
          weight_decay,
          eps,
          grad_scale_ptr);
      for (int j = 0; j < depth; ++j) {
        if (j != kGradIdx || has_grad_scale) {
          args[j][i] = tail_args[j][0];
        }
      }
    }
  }

  template <typename TensorListMetadata>
  __device__ __forceinline__ void run(
      int64_t chunk_size,
      TensorListMetadata& tl,
      int tensor_loc,
      int64_t chunk_idx,
      const float* lr_ptr,
      const double& lr,
      const double& beta1,
      const double& beta2,
      const double& weight_decay,
      const double& eps,
      const float* grad_scale_ptr,
      const float* found_inf_ptr) {
    const int64_t n_total = tl.numel_for_tensor[tensor_loc];
    const double lr_value = lr_ptr ? *lr_ptr : lr;

    if (C10_UNLIKELY(found_inf_ptr && *found_inf_ptr != 0)) {
      return;
    }

    constexpr int ilp = FusedAdamILP<scalar_type, depth>::value;
    auto bias_correction1_r_or_step_size =
        tl.bias_correction1_r_or_step_size[tensor_loc];
    auto bias_correction2_rsqrt = tl.bias_correction2_rsqrt[tensor_loc];
    // Tensor LR only changes this scalar
    const opmath_t step_size = lr_ptr
        ? static_cast<opmath_t>(lr_value) * bias_correction1_r_or_step_size
        : bias_correction1_r_or_step_size;

    scalar_type* args[depth];
    const bool all_aligned = tl.all_aligned[tensor_loc];
    init_args<opmath_t, depth>(args, tl, chunk_idx, chunk_size, tensor_loc);
    // Cast before multiplying: both chunk_idx and the launch chunk size used
    // to be 32-bit, which overflowed for tensors larger than INT32_MAX
    // elements even though numel itself is stored as int64_t.
    const int64_t chunk_offset = chunk_idx * static_cast<int64_t>(chunk_size);
    const int64_t n = n_total - chunk_offset;

    if constexpr (
        std::is_same<scalar_type, float>::value && depth == 4 && !amsgrad &&
        !has_grad_scale && !maximize && !has_weight_decay) {
      constexpr int fast_ilp = 16;
      if (all_aligned && n >= fast_ilp) {
        using Vec = at::native::memory::aligned_vector<float, fast_ilp>;
        const opmath_t beta1_t = static_cast<opmath_t>(beta1);
        const opmath_t beta2_t = static_cast<opmath_t>(beta2);
        const opmath_t eps_t = static_cast<opmath_t>(eps);
        const int64_t vector_n =
            (std::min(n, chunk_size) / fast_ilp) * fast_ilp;
        const int vector_count = vector_n / fast_ilp;
        const auto robust_size = static_cast<uint64_t>(n) * sizeof(float);
        const FusedAdamVectorAccess<float> param_desc(
            args[kParamIdx], robust_size);
        const FusedAdamVectorAccess<float> exp_avg_desc(
            args[kExpAvgIdx], robust_size);
        const FusedAdamVectorAccess<float> exp_avg_sq_desc(
            args[kExpAvgSqIdx], robust_size);
        for (int i_start = threadIdx.x; i_start < vector_count;
             i_start += blockDim.x) {
          const int element_offset = i_start * fast_ilp;
          Vec grad_vec;
#pragma unroll
          for (int j = 0; j < fast_ilp / 4; ++j) {
            reinterpret_cast<float4*>(&grad_vec)[j] = __ldg(
                reinterpret_cast<const float4*>(args[kGradIdx]) +
                i_start * (fast_ilp / 4) + j);
          }
          Vec exp_avg_vec = exp_avg_desc.template load<Vec>(element_offset);
          Vec exp_avg_sq_vec =
              exp_avg_sq_desc.template load<Vec>(element_offset);
          float updates[fast_ilp];
#pragma unroll
          for (int ii = 0; ii < fast_ilp; ++ii) {
            const opmath_t grad = grad_vec.val[ii];
            const opmath_t grad_2 = grad * grad;
            const opmath_t exp_avg =
                fmaf(beta1_t, exp_avg_vec.val[ii], fmaf(-beta1_t, grad, grad));
            const opmath_t exp_avg_sq = fmaf(
                beta2_t,
                exp_avg_sq_vec.val[ii],
                fmaf(-beta2_t, grad_2, grad_2));
            updates[ii] = step_size * exp_avg /
                fmaf(sqrtf(exp_avg_sq), bias_correction2_rsqrt, eps_t);
            exp_avg_vec.val[ii] = exp_avg;
            exp_avg_sq_vec.val[ii] = exp_avg_sq;
          }
          exp_avg_sq_desc.template store<Vec>(exp_avg_sq_vec, element_offset);
          Vec param_vec = param_desc.template load<Vec>(element_offset);
          exp_avg_desc.template store<Vec>(exp_avg_vec, element_offset);
#pragma unroll
          for (int ii = 0; ii < fast_ilp; ++ii) {
            param_vec.val[ii] -= updates[ii];
          }
          param_desc.template store<Vec>(param_vec, element_offset);
        }
        for (int64_t i = vector_n + threadIdx.x; i < n && i < chunk_size;
             i += blockDim.x) {
          const opmath_t grad = args[kGradIdx][i];
          const opmath_t grad_2 = grad * grad;
          const opmath_t exp_avg = fmaf(
              beta1_t,
              static_cast<opmath_t>(args[kExpAvgIdx][i]),
              fmaf(-beta1_t, grad, grad));
          const opmath_t exp_avg_sq = fmaf(
              beta2_t,
              static_cast<opmath_t>(args[kExpAvgSqIdx][i]),
              fmaf(-beta2_t, grad_2, grad_2));
          args[kExpAvgIdx][i] = exp_avg;
          args[kExpAvgSqIdx][i] = exp_avg_sq;
          args[kParamIdx][i] -= step_size * exp_avg /
              fmaf(sqrtf(exp_avg_sq), bias_correction2_rsqrt, eps_t);
        }
        return;
      }
    }

    // AdamW with the common scalar hyper-parameters is still a hot path for
    // real models.  Keep weight decay out of the generic r_args/AdamMath
    // kernel: an ILP16 generic fp32 kernel spills, while this compact ILP8
    // vector body retains the vector memory traffic without the large local
    // frame.  The scalar tail is handled by run_scalar_tail below.
    if constexpr (
        std::is_same<scalar_type, float>::value && depth == 4 && !amsgrad &&
        (!has_weight_decay || adam_mode == ADAM_MODE::ADAMW ||
         adam_mode == ADAM_MODE::ORIGINAL)) {
      constexpr int fast_ilp = 8;
      if (all_aligned && n >= fast_ilp) {
        using Vec = at::native::memory::aligned_vector<float, fast_ilp>;
        const opmath_t beta1_t = static_cast<opmath_t>(beta1);
        const opmath_t beta2_t = static_cast<opmath_t>(beta2);
        const opmath_t eps_t = static_cast<opmath_t>(eps);
        const opmath_t lr_t = static_cast<opmath_t>(lr_value);
        const opmath_t weight_decay_t = static_cast<opmath_t>(weight_decay);
        const opmath_t decay_t =
            static_cast<opmath_t>(1.0) - lr_t * weight_decay_t;
        const int64_t vector_n =
            (std::min(n, chunk_size) / fast_ilp) * fast_ilp;
        const int vector_count = vector_n / fast_ilp;
        const auto robust_size = static_cast<uint64_t>(n) * sizeof(float);
        const FusedAdamVectorAccess<float> param_desc(
            args[kParamIdx], robust_size);
        const FusedAdamVectorAccess<float> grad_desc(
            args[kGradIdx], robust_size);
        const FusedAdamVectorAccess<float> exp_avg_desc(
            args[kExpAvgIdx], robust_size);
        const FusedAdamVectorAccess<float> exp_avg_sq_desc(
            args[kExpAvgSqIdx], robust_size);
        for (int i_start = threadIdx.x; i_start < vector_count;
             i_start += blockDim.x) {
          const int element_offset = i_start * fast_ilp;
          Vec grad_vec;
#pragma unroll
          for (int j = 0; j < fast_ilp / 4; ++j) {
            reinterpret_cast<float4*>(&grad_vec)[j] = __ldg(
                reinterpret_cast<const float4*>(args[kGradIdx]) +
                i_start * (fast_ilp / 4) + j);
          }
          if constexpr (has_grad_scale) {
            const opmath_t grad_scale_t =
                static_cast<opmath_t>(*grad_scale_ptr);
#pragma unroll
            for (int ii = 0; ii < fast_ilp; ++ii) {
              grad_vec.val[ii] /= grad_scale_t;
            }
            grad_desc.template store<Vec>(grad_vec, element_offset);
          }
          Vec exp_avg_vec = exp_avg_desc.template load<Vec>(element_offset);
          Vec exp_avg_sq_vec =
              exp_avg_sq_desc.template load<Vec>(element_offset);
          Vec param_vec = param_desc.template load<Vec>(element_offset);
          float updates[fast_ilp];
#pragma unroll
          for (int ii = 0; ii < fast_ilp; ++ii) {
            opmath_t grad = grad_vec.val[ii];
            if constexpr (maximize) {
              grad = -grad;
            }
            grad = apply_grad_decay<adam_mode>(
                grad, param_vec.val[ii], weight_decay_t);
            const opmath_t grad_2 = grad * grad;
            const opmath_t exp_avg =
                fmaf(beta1_t, exp_avg_vec.val[ii], fmaf(-beta1_t, grad, grad));
            const opmath_t exp_avg_sq = fmaf(
                beta2_t,
                exp_avg_sq_vec.val[ii],
                fmaf(-beta2_t, grad_2, grad_2));
            updates[ii] = step_size * exp_avg /
                fmaf(sqrtf(exp_avg_sq), bias_correction2_rsqrt, eps_t);
            exp_avg_vec.val[ii] = exp_avg;
            exp_avg_sq_vec.val[ii] = exp_avg_sq;
            param_vec.val[ii] =
                apply_param_decay<adam_mode>(param_vec.val[ii], decay_t) -
                updates[ii];
          }
          exp_avg_sq_desc.template store<Vec>(exp_avg_sq_vec, element_offset);
          exp_avg_desc.template store<Vec>(exp_avg_vec, element_offset);
          param_desc.template store<Vec>(param_vec, element_offset);
        }
        if (vector_n < n && vector_n < chunk_size) {
          run_scalar_tail(
              args,
              vector_n,
              n,
              chunk_size,
              lr_value,
              beta1,
              beta2,
              step_size,
              bias_correction2_rsqrt,
              weight_decay,
              eps,
              grad_scale_ptr);
        }
        return;
      }
    }

    if constexpr (
        (std::is_same<scalar_type, c10::Half>::value ||
         std::is_same<scalar_type, c10::BFloat16>::value) &&
        depth == 4 && !amsgrad &&
        (!has_weight_decay || adam_mode == ADAM_MODE::ADAMW ||
         adam_mode == ADAM_MODE::ORIGINAL)) {
      if (all_aligned && n > 0) {
        using Vec = at::native::memory::aligned_vector<scalar_type, ilp>;
        const opmath_t beta1_t = static_cast<opmath_t>(beta1);
        const opmath_t beta2_t = static_cast<opmath_t>(beta2);
        const opmath_t eps_t = static_cast<opmath_t>(eps);
        const opmath_t lr_t = static_cast<opmath_t>(lr_value);
        const opmath_t weight_decay_t = static_cast<opmath_t>(weight_decay);
        const opmath_t decay_t =
            static_cast<opmath_t>(1.0) - lr_t * weight_decay_t;
        const int64_t vector_n = (std::min(n, chunk_size) / ilp) * ilp;
        const int vector_count = vector_n / ilp;
        const auto robust_size = static_cast<uint64_t>(n) * sizeof(scalar_type);
        const FusedAdamVectorAccess<scalar_type> param_desc(
            args[kParamIdx], robust_size);
        const FusedAdamVectorAccess<scalar_type> grad_desc(
            args[kGradIdx], robust_size);
        const FusedAdamVectorAccess<scalar_type> exp_avg_desc(
            args[kExpAvgIdx], robust_size);
        const FusedAdamVectorAccess<scalar_type> exp_avg_sq_desc(
            args[kExpAvgSqIdx], robust_size);
        for (int i_start = threadIdx.x; i_start < vector_count;
             i_start += blockDim.x) {
          const int element_offset = i_start * ilp;
          Vec grad_vec;
          *reinterpret_cast<uint2*>(&grad_vec) =
              __ldg(reinterpret_cast<const uint2*>(args[kGradIdx]) + i_start);
          Vec exp_avg_vec = exp_avg_desc.template load<Vec>(element_offset);
          Vec exp_avg_sq_vec =
              exp_avg_sq_desc.template load<Vec>(element_offset);
          Vec param_vec = param_desc.template load<Vec>(element_offset);

          float4 grad_f;
          float4 exp_avg_f;
          float4 exp_avg_sq_f;
          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            grad_f =
                __half42float4(*reinterpret_cast<const __half4*>(&grad_vec));
            exp_avg_f =
                __half42float4(*reinterpret_cast<const __half4*>(&exp_avg_vec));
            exp_avg_sq_f = __half42float4(
                *reinterpret_cast<const __half4*>(&exp_avg_sq_vec));
          } else {
            grad_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&grad_vec));
            exp_avg_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&exp_avg_vec));
            exp_avg_sq_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&exp_avg_sq_vec));
          }

          auto* grad_vals = reinterpret_cast<float*>(&grad_f);
          auto* exp_avg_vals = reinterpret_cast<float*>(&exp_avg_f);
          auto* exp_avg_sq_vals = reinterpret_cast<float*>(&exp_avg_sq_f);
          float4 param_f;
          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            param_f =
                __half42float4(*reinterpret_cast<const __half4*>(&param_vec));
          } else {
            param_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&param_vec));
          }
          auto* param_vals = reinterpret_cast<float*>(&param_f);

          if constexpr (has_grad_scale) {
            const opmath_t grad_scale_t =
                static_cast<opmath_t>(*grad_scale_ptr);
#pragma unroll
            for (int ii = 0; ii < ilp; ++ii) {
              grad_vals[ii] /= grad_scale_t;
            }
            if constexpr (std::is_same<scalar_type, c10::Half>::value) {
              *reinterpret_cast<__half4*>(&grad_vec) =
                  __float42half4_rn(grad_f);
            } else {
              *reinterpret_cast<__mt_bfloat164*>(&grad_vec) =
                  at::musa::float42bfloat164_rn(grad_f);
            }
            grad_desc.store(grad_vec, element_offset);
          }
#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            opmath_t grad = grad_vals[ii];
            if constexpr (maximize) {
              grad = -grad;
            }
            grad = apply_grad_decay<adam_mode>(
                grad, static_cast<opmath_t>(param_vals[ii]), weight_decay_t);
            const opmath_t grad_2 = grad * grad;
            const opmath_t exp_avg =
                fmaf(beta1_t, exp_avg_vals[ii], fmaf(-beta1_t, grad, grad));
            const opmath_t exp_avg_sq = fmaf(
                beta2_t, exp_avg_sq_vals[ii], fmaf(-beta2_t, grad_2, grad_2));
            grad_vals[ii] = step_size * exp_avg /
                fmaf(sqrtf(exp_avg_sq), bias_correction2_rsqrt, eps_t);
            exp_avg_vals[ii] = exp_avg;
            exp_avg_sq_vals[ii] = exp_avg_sq;
          }

          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            *reinterpret_cast<__half4*>(&exp_avg_vec) =
                __float42half4_rn(exp_avg_f);
            *reinterpret_cast<__half4*>(&exp_avg_sq_vec) =
                __float42half4_rn(exp_avg_sq_f);
          } else {
            *reinterpret_cast<__mt_bfloat164*>(&exp_avg_vec) =
                at::musa::float42bfloat164_rn(exp_avg_f);
            *reinterpret_cast<__mt_bfloat164*>(&exp_avg_sq_vec) =
                at::musa::float42bfloat164_rn(exp_avg_sq_f);
          }
          exp_avg_sq_desc.store(exp_avg_sq_vec, element_offset);
          exp_avg_desc.store(exp_avg_vec, element_offset);

#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            param_vals[ii] =
                apply_param_decay<adam_mode>(
                    static_cast<opmath_t>(param_vals[ii]), decay_t) -
                grad_vals[ii];
          }
          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            *reinterpret_cast<__half4*>(&param_vec) =
                __float42half4_rn(param_f);
          } else {
            *reinterpret_cast<__mt_bfloat164*>(&param_vec) =
                at::musa::float42bfloat164_rn(param_f);
          }
          param_desc.store(param_vec, element_offset);
        }
        if (vector_n < n && vector_n < chunk_size) {
          run_scalar_tail(
              args,
              vector_n,
              n,
              chunk_size,
              lr_value,
              beta1,
              beta2,
              step_size,
              bias_correction2_rsqrt,
              weight_decay,
              eps,
              grad_scale_ptr);
        }
        return;
      }
    }

    if constexpr (
        (std::is_same<scalar_type, c10::Half>::value ||
         std::is_same<scalar_type, c10::BFloat16>::value) &&
        depth == 5 && amsgrad) {
      if (all_aligned && n > 0) {
        using Vec = at::native::memory::aligned_vector<scalar_type, ilp>;
        const opmath_t beta1_t = static_cast<opmath_t>(beta1);
        const opmath_t beta2_t = static_cast<opmath_t>(beta2);
        const opmath_t eps_t = static_cast<opmath_t>(eps);
        const opmath_t lr_t = static_cast<opmath_t>(lr_value);
        const opmath_t weight_decay_t = static_cast<opmath_t>(weight_decay);
        const opmath_t decay_t =
            static_cast<opmath_t>(1.0) - lr_t * weight_decay_t;
        const int64_t vector_n = (std::min(n, chunk_size) / ilp) * ilp;
        const int vector_count = vector_n / ilp;
        const auto robust_size = static_cast<uint64_t>(n) * sizeof(scalar_type);
        const FusedAdamVectorAccess<scalar_type> param_desc(
            args[kParamIdx], robust_size);
        const FusedAdamVectorAccess<scalar_type> grad_desc(
            args[kGradIdx], robust_size);
        const FusedAdamVectorAccess<scalar_type> exp_avg_desc(
            args[kExpAvgIdx], robust_size);
        const FusedAdamVectorAccess<scalar_type> exp_avg_sq_desc(
            args[kExpAvgSqIdx], robust_size);
        const FusedAdamVectorAccess<scalar_type> max_exp_avg_sq_desc(
            args[kMaxExpAvgSqIdx], robust_size);
        for (int i_start = threadIdx.x; i_start < vector_count;
             i_start += blockDim.x) {
          const int element_offset = i_start * ilp;
          Vec grad_vec;
          *reinterpret_cast<uint2*>(&grad_vec) =
              __ldg(reinterpret_cast<const uint2*>(args[kGradIdx]) + i_start);
          Vec exp_avg_vec = exp_avg_desc.template load<Vec>(element_offset);
          Vec exp_avg_sq_vec =
              exp_avg_sq_desc.template load<Vec>(element_offset);
          Vec max_exp_avg_sq_vec =
              max_exp_avg_sq_desc.template load<Vec>(element_offset);
          Vec param_vec = param_desc.template load<Vec>(element_offset);

          float4 grad_f;
          float4 exp_avg_f;
          float4 exp_avg_sq_f;
          float4 max_exp_avg_sq_f;
          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            grad_f =
                __half42float4(*reinterpret_cast<const __half4*>(&grad_vec));
            exp_avg_f =
                __half42float4(*reinterpret_cast<const __half4*>(&exp_avg_vec));
            exp_avg_sq_f = __half42float4(
                *reinterpret_cast<const __half4*>(&exp_avg_sq_vec));
            max_exp_avg_sq_f = __half42float4(
                *reinterpret_cast<const __half4*>(&max_exp_avg_sq_vec));
          } else {
            grad_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&grad_vec));
            exp_avg_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&exp_avg_vec));
            exp_avg_sq_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&exp_avg_sq_vec));
            max_exp_avg_sq_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&max_exp_avg_sq_vec));
          }

          auto* grad_vals = reinterpret_cast<float*>(&grad_f);
          auto* exp_avg_vals = reinterpret_cast<float*>(&exp_avg_f);
          auto* exp_avg_sq_vals = reinterpret_cast<float*>(&exp_avg_sq_f);
          auto* max_exp_avg_sq_vals =
              reinterpret_cast<float*>(&max_exp_avg_sq_f);
          float4 param_f;
          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            param_f =
                __half42float4(*reinterpret_cast<const __half4*>(&param_vec));
          } else {
            param_f = at::musa::bfloat1642float4(
                *reinterpret_cast<const __mt_bfloat164*>(&param_vec));
          }
          auto* param_vals = reinterpret_cast<float*>(&param_f);
          if constexpr (has_grad_scale) {
            const opmath_t grad_scale_t =
                static_cast<opmath_t>(*grad_scale_ptr);
#pragma unroll
            for (int ii = 0; ii < ilp; ++ii) {
              grad_vals[ii] /= grad_scale_t;
            }
            if constexpr (std::is_same<scalar_type, c10::Half>::value) {
              *reinterpret_cast<__half4*>(&grad_vec) =
                  __float42half4_rn(grad_f);
            } else {
              *reinterpret_cast<__mt_bfloat164*>(&grad_vec) =
                  at::musa::float42bfloat164_rn(grad_f);
            }
            grad_desc.store(grad_vec, element_offset);
          }
#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            opmath_t grad = grad_vals[ii];
            if constexpr (maximize) {
              grad = -grad;
            }
            grad = apply_grad_decay<adam_mode>(
                grad, static_cast<opmath_t>(param_vals[ii]), weight_decay_t);
            const opmath_t grad_2 = grad * grad;
            const opmath_t exp_avg =
                fmaf(beta1_t, exp_avg_vals[ii], fmaf(-beta1_t, grad, grad));
            const opmath_t exp_avg_sq = fmaf(
                beta2_t, exp_avg_sq_vals[ii], fmaf(-beta2_t, grad_2, grad_2));
            const opmath_t max_exp_avg_sq =
                fmaxf(max_exp_avg_sq_vals[ii], exp_avg_sq);
            const opmath_t denom =
                fmaf(sqrtf(max_exp_avg_sq), bias_correction2_rsqrt, eps_t);
            grad_vals[ii] = step_size * exp_avg / denom;
            exp_avg_vals[ii] = exp_avg;
            exp_avg_sq_vals[ii] = exp_avg_sq;
            max_exp_avg_sq_vals[ii] = max_exp_avg_sq;
          }

          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            *reinterpret_cast<__half4*>(&exp_avg_vec) =
                __float42half4_rn(exp_avg_f);
            *reinterpret_cast<__half4*>(&exp_avg_sq_vec) =
                __float42half4_rn(exp_avg_sq_f);
            *reinterpret_cast<__half4*>(&max_exp_avg_sq_vec) =
                __float42half4_rn(max_exp_avg_sq_f);
          } else {
            *reinterpret_cast<__mt_bfloat164*>(&exp_avg_vec) =
                at::musa::float42bfloat164_rn(exp_avg_f);
            *reinterpret_cast<__mt_bfloat164*>(&exp_avg_sq_vec) =
                at::musa::float42bfloat164_rn(exp_avg_sq_f);
            *reinterpret_cast<__mt_bfloat164*>(&max_exp_avg_sq_vec) =
                at::musa::float42bfloat164_rn(max_exp_avg_sq_f);
          }
          exp_avg_sq_desc.store(exp_avg_sq_vec, element_offset);
          exp_avg_desc.store(exp_avg_vec, element_offset);
          max_exp_avg_sq_desc.store(max_exp_avg_sq_vec, element_offset);

#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            param_vals[ii] =
                apply_param_decay<adam_mode>(
                    static_cast<opmath_t>(param_vals[ii]), decay_t) -
                grad_vals[ii];
          }
          if constexpr (std::is_same<scalar_type, c10::Half>::value) {
            *reinterpret_cast<__half4*>(&param_vec) =
                __float42half4_rn(param_f);
          } else {
            *reinterpret_cast<__mt_bfloat164*>(&param_vec) =
                at::musa::float42bfloat164_rn(param_f);
          }
          param_desc.store(param_vec, element_offset);
        }
        if (vector_n < n && vector_n < chunk_size) {
          run_scalar_tail(
              args,
              vector_n,
              n,
              chunk_size,
              lr_value,
              beta1,
              beta2,
              step_size,
              bias_correction2_rsqrt,
              weight_decay,
              eps,
              grad_scale_ptr);
        }
        return;
      }
    }

    if constexpr (
        std::is_same<scalar_type, float>::value && depth == 5 && amsgrad) {
      const opmath_t beta1_t = static_cast<opmath_t>(beta1);
      const opmath_t beta2_t = static_cast<opmath_t>(beta2);
      const opmath_t eps_t = static_cast<opmath_t>(eps);
      const opmath_t lr_t = static_cast<opmath_t>(lr_value);
      const opmath_t weight_decay_t = static_cast<opmath_t>(weight_decay);
      const opmath_t decay_t =
          static_cast<opmath_t>(1.0) - lr_t * weight_decay_t;
      if (all_aligned && n > 0) {
        using Vec = at::native::memory::aligned_vector<float, ilp>;
        const int64_t vector_n = (std::min(n, chunk_size) / ilp) * ilp;
        const int vector_count = vector_n / ilp;
        const auto robust_size = static_cast<uint64_t>(n) * sizeof(float);
        const FusedAdamVectorAccess<float> param_desc(
            args[kParamIdx], robust_size);
        const FusedAdamVectorAccess<float> grad_desc(
            args[kGradIdx], robust_size);
        const FusedAdamVectorAccess<float> exp_avg_desc(
            args[kExpAvgIdx], robust_size);
        const FusedAdamVectorAccess<float> exp_avg_sq_desc(
            args[kExpAvgSqIdx], robust_size);
        const FusedAdamVectorAccess<float> max_exp_avg_sq_desc(
            args[kMaxExpAvgSqIdx], robust_size);
        for (int i_start = threadIdx.x; i_start < vector_count;
             i_start += blockDim.x) {
          const int element_offset = i_start * ilp;
          Vec grad_vec;
          *reinterpret_cast<float4*>(&grad_vec) =
              __ldg(reinterpret_cast<const float4*>(args[kGradIdx]) + i_start);
          if constexpr (has_grad_scale) {
            const opmath_t grad_scale_t =
                static_cast<opmath_t>(*grad_scale_ptr);
#pragma unroll
            for (int ii = 0; ii < ilp; ++ii) {
              grad_vec.val[ii] /= grad_scale_t;
            }
            grad_desc.template store<Vec>(grad_vec, element_offset);
          }
          Vec exp_avg_vec = exp_avg_desc.template load<Vec>(element_offset);
          Vec exp_avg_sq_vec =
              exp_avg_sq_desc.template load<Vec>(element_offset);
          Vec param_vec = param_desc.template load<Vec>(element_offset);
#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            opmath_t grad = grad_vec.val[ii];
            if constexpr (maximize) {
              grad = -grad;
            }
            grad_vec.val[ii] = apply_grad_decay<adam_mode>(
                grad, param_vec.val[ii], weight_decay_t);
          }
#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            const opmath_t grad = grad_vec.val[ii];
            const opmath_t grad_2 = grad * grad;
            const opmath_t exp_avg =
                fmaf(beta1_t, exp_avg_vec.val[ii], fmaf(-beta1_t, grad, grad));
            const opmath_t exp_avg_sq = fmaf(
                beta2_t,
                exp_avg_sq_vec.val[ii],
                fmaf(-beta2_t, grad_2, grad_2));
            exp_avg_vec.val[ii] = exp_avg;
            exp_avg_sq_vec.val[ii] = exp_avg_sq;
          }
          exp_avg_sq_desc.store(exp_avg_sq_vec, element_offset);
          Vec max_exp_avg_sq_vec =
              max_exp_avg_sq_desc.template load<Vec>(element_offset);
#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            const opmath_t max_exp_avg_sq =
                fmaxf(max_exp_avg_sq_vec.val[ii], exp_avg_sq_vec.val[ii]);
            const opmath_t denom =
                fmaf(sqrtf(max_exp_avg_sq), bias_correction2_rsqrt, eps_t);
            grad_vec.val[ii] = step_size * exp_avg_vec.val[ii] / denom;
            max_exp_avg_sq_vec.val[ii] = max_exp_avg_sq;
          }
          exp_avg_desc.store(exp_avg_vec, element_offset);
          max_exp_avg_sq_desc.store(max_exp_avg_sq_vec, element_offset);
#pragma unroll
          for (int ii = 0; ii < ilp; ++ii) {
            param_vec.val[ii] =
                apply_param_decay<adam_mode>(param_vec.val[ii], decay_t) -
                grad_vec.val[ii];
          }
          param_desc.store(param_vec, element_offset);
        }
        if (vector_n < n && vector_n < chunk_size) {
          run_scalar_tail(
              args,
              vector_n,
              n,
              chunk_size,
              lr_value,
              beta1,
              beta2,
              step_size,
              bias_correction2_rsqrt,
              weight_decay,
              eps,
              grad_scale_ptr);
        }
        return;
      }
      for (int64_t i_start = 0; i_start < n && i_start < chunk_size;
           i_start += blockDim.x * ilp) {
#pragma unroll 1
        for (int ii = 0; ii < ilp; ii++) {
          const int64_t i = i_start + threadIdx.x + ii * blockDim.x;
          if (i < n && i < chunk_size) {
            opmath_t param = args[kParamIdx][i];
            opmath_t grad = static_cast<opmath_t>(args[kGradIdx][i]);
            if constexpr (has_grad_scale) {
              grad /= static_cast<opmath_t>(*grad_scale_ptr);
              // Match AdamMath: retain the unscaled gradient in the gradient
              // list, while using the transformed value for the update.
              args[kGradIdx][i] = static_cast<scalar_type>(grad);
            }
            if constexpr (maximize) {
              grad = -grad;
            }
            grad = apply_grad_decay<adam_mode>(grad, param, weight_decay_t);
            opmath_t exp_avg = args[kExpAvgIdx][i];
            opmath_t exp_avg_sq = args[kExpAvgSqIdx][i];
            opmath_t max_exp_avg_sq = args[kMaxExpAvgSqIdx][i];
            const opmath_t grad_2 = grad * grad;
            exp_avg = fmaf(beta1_t, exp_avg, fmaf(-beta1_t, grad, grad));
            exp_avg_sq =
                fmaf(beta2_t, exp_avg_sq, fmaf(-beta2_t, grad_2, grad_2));
            max_exp_avg_sq = fmaxf(max_exp_avg_sq, exp_avg_sq);
            const opmath_t denom =
                fmaf(sqrtf(max_exp_avg_sq), bias_correction2_rsqrt, eps_t);
            param = apply_param_decay<adam_mode>(param, decay_t) -
                step_size * exp_avg / denom;
            args[kParamIdx][i] = param;
            args[kExpAvgIdx][i] = exp_avg;
            args[kExpAvgSqIdx][i] = exp_avg_sq;
            args[kMaxExpAvgSqIdx][i] = max_exp_avg_sq;
          }
        }
      }
      return;
    }

    scalar_type r_args[depth][ilp];

    if ((chunk_size % ilp == 0) && all_aligned) {
      const int64_t vector_n = (n / ilp) * ilp;
      for (int64_t i_start = threadIdx.x;
           i_start * ilp < vector_n && i_start * ilp < chunk_size;
           i_start += blockDim.x) {
        for (int i = 0; i < depth; i++) {
          load_store<ilp>(r_args[i], args[i], 0, i_start);
        }
        AdamMath<
            scalar_type,
            opmath_t,
            depth,
            ilp,
            adam_mode,
            amsgrad,
            has_grad_scale,
            maximize,
            has_weight_decay>(
            r_args,
            lr_value,
            beta1,
            beta2,
            step_size,
            bias_correction2_rsqrt,
            weight_decay,
            eps,
            grad_scale_ptr);
        for (int i = 0; i < depth; i++) {
          if (i != kGradIdx || has_grad_scale) {
            load_store<ilp>(args[i], r_args[i], i_start, 0);
          }
        }
      }
      // Keep the vectorized body for the aligned prefix and handle a partial
      // tail without reading or writing past the tensor boundary.
      for (int64_t i = vector_n + threadIdx.x; i < n && i < chunk_size;
           i += blockDim.x) {
        scalar_type tail_args[depth][1];
        for (int j = 0; j < depth; ++j) {
          tail_args[j][0] = args[j][i];
        }
        AdamMath<
            scalar_type,
            opmath_t,
            depth,
            1,
            adam_mode,
            amsgrad,
            has_grad_scale,
            maximize,
            has_weight_decay>(
            tail_args,
            lr_value,
            beta1,
            beta2,
            step_size,
            bias_correction2_rsqrt,
            weight_decay,
            eps,
            grad_scale_ptr);
        for (int j = 0; j < depth; ++j) {
          if (j != kGradIdx || has_grad_scale) {
            args[j][i] = tail_args[j][0];
          }
        }
      }
    } else {
      for (int64_t i_start = 0; i_start < n && i_start < chunk_size;
           i_start += blockDim.x * ilp) {
        load_args<depth, ilp>(r_args, args, i_start, chunk_size, n);
        AdamMath<
            scalar_type,
            opmath_t,
            depth,
            ilp,
            adam_mode,
            amsgrad,
            has_grad_scale,
            maximize,
            has_weight_decay>(
            r_args,
            lr_value,
            beta1,
            beta2,
            step_size,
            bias_correction2_rsqrt,
            weight_decay,
            eps,
            grad_scale_ptr);
        for (int i = 0; i < depth; i++) {
          if (i != kGradIdx || has_grad_scale) {
            store_args<ilp>(args[i], r_args[i], i_start, chunk_size, n);
          }
        }
      }
    }
  }

  template <FusedAdamMetadataConfig config>
  __device__ __forceinline__ void operator()(
      int64_t chunk_size,
      FusedAdamOptimizerTensorListMetadata<
          depth,
          scalar_type,
          opmath_t,
          config>& tl,
      const float* lr_ptr,
      const double& lr,
      const double& beta1,
      const double& beta2,
      const double& weight_decay,
      const double& eps,
      const float* grad_scale_ptr,
      const float* found_inf_ptr) {
    int tensor_loc = tl.block_to_tensor[blockIdx.x];
    const int64_t chunk_idx =
        tl.block_to_chunk_base[tensor_loc] + tl.block_to_chunk[blockIdx.x];
    run(chunk_size,
        tl,
        tensor_loc,
        chunk_idx,
        lr_ptr,
        lr,
        beta1,
        beta2,
        weight_decay,
        eps,
        grad_scale_ptr,
        found_inf_ptr);
  }
};

// diffs from multi_tensor_apply_for_fused_optimizer, the step_size
// and bias_correction2_rsqrt will be precomputed on the CPU side.
// assume same step across group
template <
    FusedAdamMetadataConfig config,
    typename scalar_t,
    int depth,
    typename T>
void multi_tensor_apply_for_fused_adam_impl(
    std::vector<std::vector<at::Tensor>>& tensor_lists,
    at::TensorList state_steps,
    T callable,
    const float* lr_ptr, // points to GPU address
    const double lr,
    const double beta1,
    const double beta2,
    const double weight_decay,
    const double eps,
    const float* grad_scale_ptr,
    const float* found_inf_ptr) {
  at::musa::assertNotCapturing("Cannot call fused adam/adamw");
  using opmath_t = at::opmath_type<scalar_t>;
  TORCH_CHECK(
      tensor_lists.size() == depth,
      "Number of tensor lists has to match the depth");
  const auto num_tensors = tensor_lists[0].size();
  int loc_block_info = 0;
  int loc_tensor_info = 0;
  constexpr int chunk_size = FusedAdamChunkSize<scalar_t, depth>::value;
  constexpr int block_size = FusedAdamBlockSize<scalar_t, depth>::value;
  constexpr int ilp = FusedAdamILP<scalar_t, depth>::value;
  using MetadataTraits = FusedAdamMetadataTraits<config, scalar_t, depth>;
  constexpr int max_tensors = MetadataTraits::max_tensors;
  constexpr int max_blocks = MetadataTraits::max_blocks;
  FusedAdamOptimizerTensorListMetadata<depth, scalar_t, opmath_t, config>
      tensorListMeta;
  std::vector<at::Tensor> cpu_steps(num_tensors);
  for (const auto& tensor_index : c10::irange(num_tensors)) {
    cpu_steps[tensor_index] = at::empty(
        {1},
        state_steps[tensor_index].options().device(at::kCPU).pinned_memory(
            true));
    cpu_steps[tensor_index].copy_(state_steps[tensor_index], true);
  }
  c10::musa::stream_synchronize(c10::musa::getCurrentMUSAStream());

  for (const auto& tensor_index : c10::irange(num_tensors)) {
    // short-circuit to avoid adding empty tensors to tensorListMeta
    if (tensor_lists[0][tensor_index].numel() == 0) {
      continue;
    }
    auto* step_count =
        reinterpret_cast<float*>(cpu_steps[tensor_index].data_ptr());
    if (lr_ptr) {
      tensorListMeta.bias_correction1_r_or_step_size[loc_tensor_info] =
          static_cast<opmath_t>(1.0) / (1 - std::pow(beta1, *step_count));
    } else {
      tensorListMeta.bias_correction1_r_or_step_size[loc_tensor_info] =
          static_cast<opmath_t>(lr) / (1 - std::pow(beta1, *step_count));
    }
    tensorListMeta.bias_correction2_rsqrt[loc_tensor_info] =
        1.0 / std::sqrt((1 - std::pow(beta2, *step_count)));
    tensorListMeta.numel_for_tensor[loc_tensor_info] =
        tensor_lists[0][tensor_index].numel();
    tensorListMeta.block_to_chunk_base[loc_tensor_info] = 0;
    // MUSA vector memory operations support byte-addressed (non-aligned)
    // accesses.  Keep tensors on the vector path and rely on vector_n plus
    // the scalar tail for the only unsafe condition: a short final vector.
    bool all_aligned = true;
    for (const auto& d : c10::irange(depth)) {
      const auto* data_ptr = tensor_lists[d][tensor_index].const_data_ptr();
      tensorListMeta.addresses[d][loc_tensor_info] = data_ptr;
    }
    tensorListMeta.all_aligned[loc_tensor_info] = all_aligned;
    loc_tensor_info++;

    // see above note: [chunking territory]
    const auto numel = tensor_lists[0][tensor_index].numel();
    const auto chunks = numel / chunk_size + (numel % chunk_size != 0);
    TORCH_CHECK(chunks > -1);
    for (const auto& chunk : c10::irange(chunks)) {
      const auto tensor_loc = loc_tensor_info - 1;
      const auto chunk_offset =
          chunk - tensorListMeta.block_to_chunk_base[tensor_loc];
      tensorListMeta.block_to_tensor[loc_block_info] = loc_tensor_info - 1;
      tensorListMeta.block_to_chunk[loc_block_info] =
          static_cast<unsigned short>(chunk_offset);
      loc_block_info++;

      const auto tensor_full =
          (loc_tensor_info == max_tensors && chunk == chunks - 1);
      const auto blocks_full = loc_block_info == max_blocks;
      const auto chunk_offset_full = chunk_offset == UINT16_MAX;

      if (tensor_full || blocks_full || chunk_offset_full) {
        multi_tensor_apply_kernel<block_size, chunk_size>
            <<<loc_block_info,
               block_size,
               0,
               c10::musa::getCurrentMUSAStream()>>>(
                tensorListMeta,
                callable,
                lr_ptr,
                lr,
                beta1,
                beta2,
                weight_decay,
                eps,
                grad_scale_ptr,
                found_inf_ptr);
        C10_MUSA_KERNEL_LAUNCH_CHECK();

        // Reset.
        loc_block_info = 0;
        if (chunk == chunks - 1) {
          loc_tensor_info = 0;
        } else {
          tensorListMeta.numel_for_tensor[0] =
              tensorListMeta.numel_for_tensor[loc_tensor_info - 1];
          tensorListMeta.bias_correction1_r_or_step_size[0] =
              tensorListMeta
                  .bias_correction1_r_or_step_size[loc_tensor_info - 1];
          tensorListMeta.bias_correction2_rsqrt[0] =
              tensorListMeta.bias_correction2_rsqrt[loc_tensor_info - 1];
          tensorListMeta.block_to_chunk_base[0] = chunk + 1;
          tensorListMeta.all_aligned[0] =
              tensorListMeta.all_aligned[loc_tensor_info - 1];
          for (const auto& d : c10::irange(depth)) {
            tensorListMeta.addresses[d][0] =
                tensorListMeta.addresses[d][loc_tensor_info - 1];
          }
          loc_tensor_info = 1;
        }
      }
    }
  }

  // see above note: [finishing what we've started]
  if (loc_block_info != 0) {
    multi_tensor_apply_kernel<block_size, chunk_size>
        <<<loc_block_info, block_size, 0, c10::musa::getCurrentMUSAStream()>>>(
            tensorListMeta,
            callable,
            lr_ptr,
            lr,
            beta1,
            beta2,
            weight_decay,
            eps,
            grad_scale_ptr,
            found_inf_ptr);
    C10_MUSA_KERNEL_LAUNCH_CHECK();
  }
}

template <
    FusedAdamMetadataConfig config,
    typename scalar_t,
    int depth,
    ADAM_MODE adam_mode,
    bool amsgrad,
    bool has_grad_scale,
    bool maximize_value,
    bool has_weight_decay>
void multi_tensor_apply_for_fused_adam_specialized(
    std::vector<std::vector<at::Tensor>>& tensor_lists,
    at::TensorList state_steps,
    const float* lr_ptr,
    const double lr,
    const double beta1,
    const double beta2,
    const double weight_decay,
    const double eps,
    const float* grad_scale_ptr,
    const float* found_inf_ptr) {
  multi_tensor_apply_for_fused_adam_impl<config, scalar_t, depth>(
      tensor_lists,
      state_steps,
      FusedAdamMathFunctor<
          scalar_t,
          depth,
          adam_mode,
          amsgrad,
          has_grad_scale,
          maximize_value,
          has_weight_decay>(),
      lr_ptr,
      lr,
      beta1,
      beta2,
      weight_decay,
      eps,
      grad_scale_ptr,
      found_inf_ptr);
}

template <
    FusedAdamMetadataConfig config,
    typename scalar_t,
    int depth,
    ADAM_MODE adam_mode,
    bool amsgrad,
    bool has_grad_scale,
    bool maximize_value>
void multi_tensor_apply_for_fused_adam_weight_decay_dispatch(
    std::vector<std::vector<at::Tensor>>& tensor_lists,
    at::TensorList state_steps,
    const float* lr_ptr,
    const double lr,
    const double beta1,
    const double beta2,
    const double weight_decay,
    const double eps,
    const float* grad_scale_ptr,
    const float* found_inf_ptr) {
  if (weight_decay != 0) {
    multi_tensor_apply_for_fused_adam_specialized<
        config,
        scalar_t,
        depth,
        adam_mode,
        amsgrad,
        has_grad_scale,
        maximize_value,
        true>(
        tensor_lists,
        state_steps,
        lr_ptr,
        lr,
        beta1,
        beta2,
        weight_decay,
        eps,
        grad_scale_ptr,
        found_inf_ptr);
  } else {
    multi_tensor_apply_for_fused_adam_specialized<
        config,
        scalar_t,
        depth,
        adam_mode,
        amsgrad,
        has_grad_scale,
        maximize_value,
        false>(
        tensor_lists,
        state_steps,
        lr_ptr,
        lr,
        beta1,
        beta2,
        weight_decay,
        eps,
        grad_scale_ptr,
        found_inf_ptr);
  }
}

template <
    FusedAdamMetadataConfig config,
    typename scalar_t,
    int depth,
    ADAM_MODE adam_mode,
    bool amsgrad>
void multi_tensor_apply_for_fused_adam_amp_dispatch(
    std::vector<std::vector<at::Tensor>>& tensor_lists,
    at::TensorList state_steps,
    const float* lr_ptr,
    const double lr,
    const double beta1,
    const double beta2,
    const double weight_decay,
    const double eps,
    const bool maximize,
    const float* grad_scale_ptr,
    const float* found_inf_ptr) {
  if (maximize) {
    if (grad_scale_ptr) {
      multi_tensor_apply_for_fused_adam_weight_decay_dispatch<
          config,
          scalar_t,
          depth,
          adam_mode,
          amsgrad,
          true,
          true>(
          tensor_lists,
          state_steps,
          lr_ptr,
          lr,
          beta1,
          beta2,
          weight_decay,
          eps,
          grad_scale_ptr,
          found_inf_ptr);
    } else {
      multi_tensor_apply_for_fused_adam_weight_decay_dispatch<
          config,
          scalar_t,
          depth,
          adam_mode,
          amsgrad,
          false,
          true>(
          tensor_lists,
          state_steps,
          lr_ptr,
          lr,
          beta1,
          beta2,
          weight_decay,
          eps,
          grad_scale_ptr,
          found_inf_ptr);
    }
  } else if (grad_scale_ptr) {
    multi_tensor_apply_for_fused_adam_weight_decay_dispatch<
        config,
        scalar_t,
        depth,
        adam_mode,
        amsgrad,
        true,
        false>(
        tensor_lists,
        state_steps,
        lr_ptr,
        lr,
        beta1,
        beta2,
        weight_decay,
        eps,
        grad_scale_ptr,
        found_inf_ptr);
  } else {
    multi_tensor_apply_for_fused_adam_weight_decay_dispatch<
        config,
        scalar_t,
        depth,
        adam_mode,
        amsgrad,
        false,
        false>(
        tensor_lists,
        state_steps,
        lr_ptr,
        lr,
        beta1,
        beta2,
        weight_decay,
        eps,
        grad_scale_ptr,
        found_inf_ptr);
  }
}

} // anonymous namespace

inline void check_fused_adam_inputs(
    at::TensorList params,
    at::TensorList state_steps,
    const c10::optional<at::Tensor>& grad_scale,
    const c10::optional<at::Tensor>& found_inf) {
  TORCH_CHECK(!params.empty(), "params must not be empty");
  TORCH_CHECK(
      state_steps.size() == params.size(),
      "state_steps must have one entry per parameter");
  for (const auto& step : state_steps) {
    TORCH_CHECK(
        step.scalar_type() == at::kFloat,
        "state_steps should have float32 dtype");
    TORCH_CHECK(
        step.numel() == 1, "each state_step must be a singleton tensor");
  }

  const auto param_device = params[0].device();
  for (const auto* aux : {&grad_scale, &found_inf}) {
    if (!aux->has_value()) {
      continue;
    }
    const auto& tensor = aux->value();
    TORCH_CHECK(
        tensor.scalar_type() == at::kFloat,
        "grad_scale and found_inf should have float32 dtype");
    TORCH_CHECK(
        tensor.numel() == 1,
        "grad_scale and found_inf should be singleton tensors");
    TORCH_CHECK(
        tensor.device() == param_device,
        "grad_scale and found_inf must be on the parameter device");
  }
}

